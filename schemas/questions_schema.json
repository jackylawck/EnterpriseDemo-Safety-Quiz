{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jackylawck.github.io/EnterpriseDemo-Safety-Quiz/schemas/questions_schema.json",
  "title": "SED Onboarding Safety Quiz Bank Schema",
  "description": "Strict JSON Schema governing the dynamic QUESTIONS_JSON payload stored in Streamlit Secrets for EnterpriseDemo-Safety-Quiz.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "type", "question", "options", "answer"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "integer",
        "minimum": 1,
        "description": "Unique sequential identifier for the safety assessment question."
      },
      "type": {
        "type": "string",
        "enum": ["single"],
        "description": "Question evaluation mode (deterministic single-choice)."
      },
      "question": {
        "type": "string",
        "minLength": 5,
        "maxLength": 300,
        "description": "Localized safety training assessment prompt."
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": "Available multiple-choice options presented to the worker."
      },
      "answer": {
        "type": "string",
        "minLength": 1,
        "description": "Exact string matching the correct option in the options array."
      }
    }
  }
}
